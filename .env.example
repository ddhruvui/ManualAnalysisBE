# Copy to .env and fill in. .env is git-ignored — never commit real values.

# --- RunPod S3 API keys (RunPod console → Settings → S3 API Keys) ---
AWS_ACCESS_KEY_ID=user_xxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=rps_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Network volume (bucket name = volume ID) ---
RUNPOD_VOLUME_ID=your_volume_id
RUNPOD_S3_REGION=eu-ro-1
RUNPOD_S3_ENDPOINT=https://s3api-eu-ro-1.runpod.io
RUNPOD_DATACENTER=EU-RO-1

# --- Optional: article summaries (Google AI Studio key). Leave unset to disable. ---
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the main model is overloaded (503) or out of quota (429). "none" disables.
# GEMINI_FALLBACK_MODEL=gemini-flash-latest,gemini-flash-lite-latest

# --- Pinned tickers (MongoDB Atlas). Unset => pinning is disabled, the rest still works. ---
# Paste the Atlas connection string as-is; the <db_password> placeholder is filled from DB_PASSWORD.
# MONGO_URI='mongodb+srv://user:<db_password>@cluster.example.mongodb.net/?appName=YourApp'
# DB_PASSWORD=your_db_password
# MONGO_DB=news_reader

# --- Optional: cross-origin access (only needed if the frontend is served elsewhere) ---
# Comma-separated origins allowed to call this API from a browser. Unset = no CORS headers,
# which is right for the local setup (the Vite dev proxy is same-origin). Must match the
# frontend's own origin, e.g. https://manualanalysis-fe.example.com. "*" allows every site
# to read this API — including the licensed article text — so avoid it.
# ALLOWED_ORIGINS=

# --- Optional ---
# PORT=4000            # the frontend's Vite proxy assumes 4000
# CACHE_DIR=.cache     # where the local SQLite index is stored
